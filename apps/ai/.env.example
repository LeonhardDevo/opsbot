# ─────────────────────────────────────────────────────────────────────────────
# AI / RAG service (FastAPI). Copy to apps/ai/.env — every value has a working
# offline default (mock LLM, local or hash embeddings), keys are optional.
# ─────────────────────────────────────────────────────────────────────────────

# local | development | testing | staging | production (production: JSON logs advised,
# /docs disabled, AI_SETTINGS_KEY required)
APP_ENV=local
# HTTP port (PLATFORM.md §2)
PORT=8202
# Product name used in the assistant's system prompt (brand lives in config, not code)
PRODUCT_NAME=OpsBot
PRODUCT_SLUG=opsbot
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true → one JSON object per log line (production); false → coloured console
LOG_JSON=false

# Postgres (docker compose pgvector on 5442 — never the native 5432). The service
# owns only the `rag` schema; migrate with `uv run alembic upgrade head`.
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5442/opsbot
DB_POOL_SIZE=10
# Test DB used by pytest (created by infra/postgres/init)
TEST_DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5442/opsbot_test

# Shared HMAC secret for signed service-to-service calls — MUST equal web and worker (setup writes it).
# Empty outside production → "dev-internal-secret-not-for-production" (the same fallback as web and worker);
# development fallback only once the pair keys below are set.
INTERNAL_API_SECRET=
# Per-pair keys (ADR-0010): web <-> ai and worker <-> ai (setup writes them). Required (32+ chars, distinct)
# in production, where INTERNAL_API_SECRET is no longer used for signing. Empty outside production = INTERNAL_API_SECRET.
INTERNAL_KEY_WEB_AI=
INTERNAL_KEY_WORKER_AI=
# Accepted clock skew for signed requests (seconds)
INTERNAL_API_TOLERANCE=300

# Web app internal API (document download, status callbacks, ai-query log)
WEB_URL=http://127.0.0.1:8200
# Public URL used in citation links (defaults to WEB_URL)
WEB_PUBLIC_URL=http://localhost:8200
WEB_TIMEOUT_SECONDS=30
# Largest document the service downloads (MB)
MAX_FILE_MB=50

# Fernet key (or any passphrase) that encrypts provider API keys saved from the admin UI.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty outside production → derived from INTERNAL_API_SECRET. Changing it invalidates saved keys.
AI_SETTINGS_KEY=

# ── LLM defaults (the admin UI settings stored in rag.settings take precedence) ──
# mock | anthropic | openai | deepseek | openrouter | nvidia | opencode-zen | opencode-go | ollama
AI_PROVIDER=mock
# Empty → the provider's default model (anthropic: claude-opus-5-5, mock: mock-extractive-1)
AI_MODEL=
# Used on 404/403 and after 3 rate-limited attempts
AI_FALLBACK_MODEL=
# Sent only to providers that accept it (never to Anthropic, never to OpenAI reasoning models)
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
# 429 / transient retry backoff (seconds); retry-after headers win
AI_RETRY_BASE_SECONDS=2
AI_RETRY_MAX_SECONDS=30
AI_REQUEST_TIMEOUT_SECONDS=90
# Anthropic server-side refusal fallbacks (`fallbacks: "default"`) on models that support them
ANTHROPIC_SERVER_FALLBACKS=true

# ── Provider keys (optional; a key saved in the admin UI overrides these) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# OpenCode Zen and Go share one key when only one is set
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# Keyless local models
OLLAMA_BASE_URL=http://localhost:11434/v1
# Workspaces that do not allow external LLM providers are answered by this local model
# (PLATFORM.md section 10.2): mock (offline, extractive) or ollama (OLLAMA_BASE_URL).
LOCAL_LLM_PROVIDER=mock

# ── Embeddings ──
# local (fastembed, CPU) | openai-compatible (OpenAI / NVIDIA / Ollama /embeddings) | hash (deterministic, tests)
# Dev default: hash (no ~220 MB model download, instant start). Production: local (or openai-compatible),
# then re-embed from /admin/ai. The code default when unset is local.
EMBEDDINGS_PROVIDER=hash
# Empty → provider default: local = sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384-d, ~220 MB, RU+EN)
EMBEDDINGS_MODEL=
# openai-compatible only: endpoint, key (falls back to OPENAI_API_KEY) and vector size
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIMS=384
EMBEDDINGS_BATCH_SIZE=32
# Model cache shared by all projects (default ~/.cache/fastembed). If the local model cannot be
# loaded (e.g. offline first run) the service logs a warning and uses `hash` embeddings.
FASTEMBED_CACHE_PATH=
# While the model is still loading/downloading, chat and search wait at most this long and then use
# `hash` embeddings for that request (ingest and re-embed always wait for the real model)
EMBEDDINGS_LOAD_WAIT_SECONDS=15

# ── RAG ──
# Answers are refused (with an `escalate` action) below this fused confidence (0..1)
RAG_MIN_CONFIDENCE=0.35
# Sources given to the model per question / candidates per retriever before RRF fusion
RAG_TOP_K=6
RAG_CANDIDATES=40
RAG_RRF_K=60
# Chunk size (~tokens) and overlap ratio
RAG_CHUNK_TOKENS=700
RAG_CHUNK_OVERLAP=0.15
# Conversation memory: last N turns per conversation_id
RAG_MEMORY_TURNS=6
# Comma-separated roles that see role-restricted documents (empty = strict role match)
RAG_PRIVILEGED_ROLES=
# Agent tool rounds per question
AGENT_MAX_ITERATIONS=4

# ── OCR (Tesseract on PATH) ──
# Missing language packs degrade with a warning (install `rus` traineddata for Russian scans)
OCR_LANGUAGES=rus+eng
# Full path to tesseract(.exe) when it is not on PATH
TESSERACT_CMD=
OCR_DPI=300
