{
  "name": "@opsbot/worker",
  "private": true,
  "version": "0.1.0",
  "description": "OpsBot worker: BullMQ queues, outbox relay, email delivery, Telegram bot and webhook ingress.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrateCli.ts",
    "migrate:prod": "node dist/db/migrateCli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/fastify": "^9.10.4",
    "bullmq": "^5.81.5",
    "fastify": "^5.12.7",
    "grammy": "^1.46.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.2.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
