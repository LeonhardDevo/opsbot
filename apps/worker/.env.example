# ---------------------------------------------------------------------------
# Worker service (Node 24 · BullMQ · grammY · Fastify)
# Copy to .env and adjust. Empty values (KEY=) mean "unset": the documented default applies.
# Without a .env the worker (outside production) falls back to this file, so a fresh clone
# runs fully offline: no Telegram/Stripe keys needed. Real process env always wins over files.
# ---------------------------------------------------------------------------

# Runtime: development | test | production. Production enforces 32+ char, distinct INTERNAL_KEY_* pair keys,
# a real STRIPE_WEBHOOK_SECRET, and disables /dev/* routes regardless of DEV_ROUTES.
NODE_ENV=development
# HTTP bind address/port (Fastify). Use 0.0.0.0 inside containers.
HOST=127.0.0.1
PORT=8201
# pino level: fatal|error|warn|info|debug|trace|silent. LOG_PRETTY=1 needs the pino-pretty dev dependency.
LOG_LEVEL=info
LOG_PRETTY=0

# Product identity (all user-facing bot/email strings use these; nothing is hard-coded).
PRODUCT_NAME="OpsBot"
PRODUCT_SLUG=opsbot

# Postgres (docker compose, pgvector image). The worker migrates only the `worker` schema.
DATABASE_URL=postgres://app:app@127.0.0.1:5442/opsbot
DATABASE_POOL_MAX=10
# Redis 7 (docker compose). Never the native Redis 3 on 6379.
REDIS_URL=redis://127.0.0.1:6392
# BullMQ key prefix.
QUEUE_PREFIX=bull

# Service-to-service signing (PLATFORM.md §4.1). MUST be identical in web, worker and ai .env.
# Left empty here: `npm run setup` (scripts/env-sync.ts) writes one shared value into every app.
# Empty outside production = built-in development secret (with a warning); required (32+ chars) in production.
INTERNAL_API_SECRET=
# Per-pair keys (ADR-0010): web <-> worker and worker <-> ai. Written by `npm run setup`; required in
# production. Empty outside production = INTERNAL_API_SECRET above.
INTERNAL_KEY_WEB_WORKER=
INTERNAL_KEY_WORKER_AI=
# Internal base URLs of the other services.
WEB_URL=http://127.0.0.1:8200
AI_URL=http://127.0.0.1:8202
# Public URL of the web app used in links shown to users (defaults to WEB_URL).
WEB_PUBLIC_URL=http://127.0.0.1:8200
# Timeouts (ms) for web calls, ai /v1/chat and ai ingest/re-embed.
WEB_TIMEOUT_MS=10000
AI_CHAT_TIMEOUT_MS=90000
AI_INGEST_TIMEOUT_MS=600000
# Upper bound for one document extraction call to the ai service (parsing + OCR), ms.
DOCUMENT_EXTRACT_TIMEOUT_MS=1500000
# Prefix for worker Redis keys (accounts cache, actions, flows, rate buckets, polling locks). Defaults to <PRODUCT_SLUG>:.
REDIS_PREFIX=

# Transactional outbox relay (PLATFORM.md §4.2).
OUTBOX_ENABLED=1
OUTBOX_TABLE=public.outbox_messages
OUTBOX_CHANNEL=outbox
OUTBOX_POLL_MS=2000
OUTBOX_BATCH_SIZE=100
# Set to 0 to run only HTTP + relay (no BullMQ consumers), e.g. for a dedicated ingress replica.
WORKERS_ENABLED=1
# Daily privacy purge (due deletions + retention, PLATFORM.md section 10.2): cron in UTC; empty disables it.
PRIVACY_PURGE_CRON="15 3 * * *"
BILLING_RENEWALS_CRON="20 * * * *"
WEBHOOK_TRUSTED_PROXY_HOPS=0

# Stripe: webhook signing secret (Stripe's whsec_… or the fake-billing secret shared with web).
# Empty = whsec_test_local (the fake-billing default, outside production only); setup syncs the same value into web.
# Production refuses to start without a real whsec_… secret.
STRIPE_WEBHOOK_SECRET=
# Optional; not needed for webhook verification.
STRIPE_SECRET_KEY=

# Telegram bot. Without a token the bot runs offline: outbound calls are captured
# (see GET /dev/telegram/outbox) and /dev/telegram/update still works.
# Mode: polling | webhook | disabled (without a token the mode is irrelevant: the bot is offline).
TELEGRAM_MODE=disabled
# auto: tokens matching <digits>:TEST<30+ chars> use the fake transport, others call Telegram; fake: every bot uses the fake transport (CI).
TELEGRAM_DRIVER=auto
# Public HTTPS base URL of this worker; company bot webhooks are registered at <WORKER_PUBLIC_URL>/webhooks/telegram/<bot_key>.
WORKER_PUBLIC_URL=
# Outbound notification limits per bot and per chat (messages per second).
TELEGRAM_BOT_RATE_PER_S=25
TELEGRAM_CHAT_RATE_PER_S=1
TELEGRAM_BOT_TOKEN=
# Username without @ (used for deep links); defaults to <PRODUCT_SLUG>_bot.
TELEGRAM_BOT_USERNAME=opsbot_bot
# Webhook mode: Telegram sends this in X-Telegram-Bot-Api-Secret-Token; URL is registered on start.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Bot API root (change only for a self-hosted Bot API server).
TELEGRAM_API_ROOT=https://api.telegram.org
# Per-chat rate limit: BOT_RATE_LIMIT messages per BOT_RATE_WINDOW_S seconds.
BOT_RATE_LIMIT=20
BOT_RATE_WINDOW_S=60
# Lifetime of inline-button actions stored in Redis (seconds).
BOT_ACTION_TTL_S=86400
# Cache of the web telegram context per user (seconds; 0 disables).
BOT_ACCOUNT_CACHE_TTL_S=60

# SMTP (Mailpit in dev: UI on http://127.0.0.1:8231).
SMTP_HOST=127.0.0.1
SMTP_PORT=1032
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
# Defaults to "<PRODUCT_NAME>" <no-reply@<PRODUCT_SLUG>.test>.
MAIL_FROM=

# Dev/test routes (/dev/telegram/*). Ignored when NODE_ENV=production.
DEV_ROUTES=1
# Bull Board at /admin/queues (basic auth). The dashboard is disabled while the password is empty;
# `npm run setup` generates one.
QUEUE_DASHBOARD_USER=admin
QUEUE_DASHBOARD_PASSWORD=
